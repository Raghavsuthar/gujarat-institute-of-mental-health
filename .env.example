# Server-only Google Gemini API key. Never expose this through a VITE_ variable.
GEMINI_API_KEY=

# Server-only admin secret. Generate a unique random value of at least 32 characters.
ADMIN_PASSWORD=

# Upstash Redis REST credentials for durable analytics and shared rate limiting.
# Create a Redis database, then configure these values in local env / Vercel server-side settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional extra salt for hashing transient rate-limit identifiers; keep server-side.
RATE_LIMIT_SALT=

# Used by the self-hosted Express server; Vercel Functions ignore this.
PORT=3000
